# Copy this file to .env and adjust as needed.
# `docker compose` automatically reads .env for variable substitution in docker-compose.yml.

# --- Airflow admin account (created once by the airflow-init service) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Inference device ---
# "auto" picks cuda if available, otherwise cpu. Set explicitly to "cpu" to force CPU-only.
DEVICE=auto

# --- Model checkpoints (Hugging Face model ids, auto-downloaded & cached on first run) ---
GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
SAM_MODEL_ID=facebook/sam-vit-base

# --- Stage 1 (GroundingDINO) thresholds ---
# Lower BOX_THRESHOLD = more candidate detections (higher recall, more false positives).
BOX_THRESHOLD=0.30
TEXT_THRESHOLD=0.25

# --- Output ---
# "polygon" (default, no extra dependency) or "rle" (requires pycocotools, see requirements/api.txt)
SEGMENTATION_FORMAT=polygon

# --- Performance ---
MAX_BATCH_SIZE=8
