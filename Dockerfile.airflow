# syntax=docker/dockerfile:1
#
# Extends the official Airflow image with the extra Python packages the
# instrument-labeling DAG and plugins need (opencv, requests, numpy).
# Airflow's own dependencies are intentionally left untouched — installing
# against Airflow's published constraints file avoids resolver conflicts.

ARG AIRFLOW_VERSION=2.9.2
ARG PYTHON_VERSION=3.11
FROM apache/airflow:${AIRFLOW_VERSION}-python${PYTHON_VERSION}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

USER airflow

COPY requirements/airflow.txt /requirements/airflow.txt
RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt" \
    -r /requirements/airflow.txt

COPY airflow/dags /opt/airflow/dags
COPY airflow/plugins /opt/airflow/plugins
