# Data (videos/frames/output are run artifacts, not source — keep .gitkeep placeholders only)
data/input_videos/*
data/input_images/*
data/output/*
data/_frames_tmp/*
!data/input_videos/.gitkeep
!data/input_images/.gitkeep
!data/output/.gitkeep

